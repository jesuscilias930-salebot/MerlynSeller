# Generate a long random value for the token configured in Meta's webhook UI.
VERIFY_TOKEN=replace-with-a-long-random-token
# Meta App Dashboard > Settings > Basic > App secret. Never commit this value.
META_APP_SECRET=replace-with-your-meta-app-secret
PORT=3000
NODE_ENV=development
TRUST_PROXY=false
REQUIRE_HTTPS=false
WEBHOOK_MAX_BODY_SIZE=256kb
WEBHOOK_DEDUPLICATION_TTL_MS=86400000

# WhatsApp Cloud API outbound messages. Keep these in your secret manager.
WHATSAPP_ACCESS_TOKEN=replace-with-a-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-your-phone-number-id
# Set the Graph API version enabled for the app in Meta (for example, v25.0).
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_REQUEST_TIMEOUT_MS=10000
WHATSAPP_MEDIA_UPLOAD_TIMEOUT_MS=120000
# Meta Conversions API for WhatsApp chat events. Keep this token only in the
# backend environment (Render secret), never in NEXT_PUBLIC_* frontend values.
META_CAPI_ENABLED=false
META_CAPI_ACCESS_TOKEN=
META_CAPI_DATASET_ID=
META_CAPI_PAGE_ID=
META_CAPI_GRAPH_API_VERSION=v25.0
# Set only while validating from Meta's "Probar eventos" screen, then remove it.
META_CAPI_TEST_EVENT_CODE=
OPENAI_API_KEY=
OPENAI_AUTOMATION_MODEL=
# Protects the local /messages endpoints from unauthorized callers.
OUTBOUND_API_KEY=replace-with-a-long-random-api-key

# Local development: docker compose up -d
DATABASE_URL=postgresql://merlynsales:change-this-local-password@localhost:5432/merlynsales
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
SESSION_TTL_MS=28800000
# Supabase project settings > API. The browser uses Supabase to sign in, then
# exchanges the short-lived access token for this backend's HttpOnly session cookie.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
FRONTEND_ORIGIN=http://localhost:5173
